{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET: Lifenizer.Api (Development)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "backend: build",
            "program": "${workspaceFolder}/backend/Lifenizer.Api/bin/Debug/net10.0/Lifenizer.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/backend/Lifenizer.Api",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": ".NET: Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}