{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "lifenizer-next",
    "Secret": "replace-this-development-secret-with-a-host-secret-please"
  },
  "Auth": {
    "AllowDevLogin": false
  },
  "ConnectionStrings": {
